<?xml version="1.0" encoding="utf-8"?>
<!--
  融合后的清单：一个 app 里同时有「一碰互联」的 NFC/传输层和碰一碰动效层。

  组件分工：
    · HomeActivity            启动页：选两张图看动效；也可以把选中的照片交给常驻服务等碰一碰
    · nfc.MainActivity        NFC 联调页（二级）：日志控制台 / 角色切换 / 选图 / reader 模式 / 分享入口
    · nfc.TapDispatchActivity 透明跳板：系统把 NFC 标签交给它 → 转交常驻服务 → 秒退
    · nfc.TapService          常驻服务：碰一碰主流程（弹动效页 → Xfer 传图）
    · nfc.HceService          HCE 卡模拟（发送侧）
    · service.OverlayService  动效层宿主：前台服务 + 整屏悬浮窗（GL 水波 + OverlayView）

  权限按来源分三段：NFC、悬浮窗/前台服务、传输通道。全部沿用两个源工程原有声明，
  没有新增（改动权限会改变已验证过的那套流程）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC：安装期权限；HCE 卡模拟不需要运行时权限 -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- 悬浮窗 + 前台服务 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- pri added by zhuyang,Change 1: the main window is TYPE_NAVIGATION_BAR_PANEL (layer 25) now, and DisplayPolicy.validateAddingWindowLw enforces STATUS_BAR_SERVICE on that type; protectionLevel is signature|recents, so a platform-signed /system/app gets it by declaring it,20261014 -->
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- pri added by zhuyang,Copied from the reference (LongShotScreen app/src/main/AndroidManifest.xml), which declares them for the same ScreenshotHelper call. INTERACT_ACROSS_USERS is the one its ROM side whitelists for priv-app; SYSTEM_OVERLAY_WINDOW is not even defined by this platform build, so it stays an inert request,20261014,start -->
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <!-- pri added by zhuyang,Copied from the reference (LongShotScreen app/src/main/AndroidManifest.xml), which declares them for the same ScreenshotHelper call. INTERACT_ACROSS_USERS is the one its ROM side whitelists for priv-app; SYSTEM_OVERLAY_WINDOW is not even defined by this platform build, so it stays an inert request,20261014,end -->

    <!-- 传输通道：同 Wi-Fi 直连 / 本地热点 / Wi-Fi Direct / 蓝牙名 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- pri added by zhuyang,Bluetooth SPP control side channel; LOCAL_MAC_ADDRESS lets getAddress() return the real MAC on a platform-signed build,20261020,start -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />
    <!-- pri added by zhuyang,Bluetooth SPP control side channel; LOCAL_MAC_ADDRESS lets getAddress() return the real MAC on a platform-signed build,20261020,end -->

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- pri modify by chenpengqi,Gesture-nav Back never reached the animation window: no OnBackInvokedCallback was registered by this app, CoreBackPreview resolved the gesture against the activity underneath (BackNavigationInfo TYPE_RETURN_TO_HOME), and SystemUI's edge handler refuses the swipe for this focused overlay window (mAllowGesture=false - measured on the old build as well); opting in lets the window own Back,20261016,start -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NFCTouchDemo">
    <!-- pri modify by chenpengqi,Gesture-nav Back never reached the animation window: no OnBackInvokedCallback was registered by this app, CoreBackPreview resolved the gesture against the activity underneath (BackNavigationInfo TYPE_RETURN_TO_HOME), and SystemUI's edge handler refuses the swipe for this focused overlay window (mAllowGesture=false - measured on the old build as well); opting in lets the window own Back,20261016,end -->

        <!-- 启动页：动效演示 + 一碰互联入口 -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          NFC 联调页（二级）：带日志控制台，方便用 adb 顶掉碰触这一步做回归。
          顺带保留两个分享入口 —— 相册/文件管理器选中图片后分享过来，等价于"相册把当前选中推给服务"。
        -->
        <activity
            android:name=".nfc.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          pri added by zhuyang,D5: in-app image viewer (replaces the Google Photos pager),20261014,start
          Opened by nfc.TapService (explicit intent, FLAG_ACTIVITY_NEW_TASK) after a transfer completed,
          showing only the photos of that transfer. It is a real Activity, not the overlay path.
            · exported=false      - only our own service / app starts it, nobody else needs to
            · launchMode=singleTop - a second transfer while the viewer is up updates this instance
                                     (onNewIntent) instead of stacking a second viewer
            · excludeFromRecents  - a transient viewer must not litter the recents stack (if the viewer
                                     ever becomes the root of its own task, that task stays out of recents)
            · configChanges       - rotation is handled in place (ZoomImageView refits itself), so the
                                     photo is not decoded again and no Activity restart is involved
            · theme               - windowAnimationStyle=@null: the transition is ours to kill, see themes.xml
          pri added by zhuyang,D5: in-app image viewer (replaces the Google Photos pager),20261014,end
        -->
        <activity
            android:name=".viewer.ImageViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NFCTouchDemo.Viewer" />

        <!--
          透明跳板：系统把 NFC 标签交给它 → 立即转交常驻服务处理（弹动效悬浮窗）→ 自身秒退。
          界面不可见，所以用透明主题，且不进最近任务。
        -->
        <activity
            android:name=".nfc.TapDispatchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/tech_list" />
        </activity>

        <!-- 常驻服务：碰一碰主流程（demo 开放给调试相册调用；产品化改用签名级权限） -->
        <service
            android:name=".nfc.TapService"
            android:exported="true" />

        <!-- 卡模拟（发送侧）：AID 见 res/xml/apdu_service.xml -->
        <service
            android:name=".nfc.HceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>

        <!--
          动效层宿主：动效本体盖在**别的应用之上**，服务常驻。
          动效窗口的触摸穿透开关放在通知里 —— 窗口一旦 FLAG_NOT_TOUCHABLE，
          它自己的按钮就点不到了，所以这个开关必须在窗口外。
        -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="touch_anime_overlay" />
        </service>

        <!--
          pri added by zhuyang,Accessibility service behind the gallery pickup,20261016,start
          Reads the gallery's node tree when the phones are tapped, to learn which photo is open
          (or which tiles are ticked). The tree never names the file - only the capture time and
          the on-screen position - so GalleryPickup turns that into a real MediaStore Uri by
          filtering on the time and then matching the pixels.
          Without it the tap still works; it just degrades to "this phone has nothing to send".
          Class name says "Probe" for historical reasons (it started as a throwaway probe).
          pri added by zhuyang,Accessibility service behind the gallery pickup,20261016,end
        -->
        <service
            android:name=".nfc.AccessibilityProbeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_probe_config" />
        </service>
    </application>

</manifest>

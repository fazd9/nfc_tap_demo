<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      融合后统一用动效层（Test）那套深色主题：整套动效都在深色底上呈现，
      日间/夜间保持一致（values-night/themes.xml 里是同一份 Base）。
    -->
    <style name="Base.Theme.NFCTouchDemo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/demo_background</item>

        <!-- 系统栏全透明：悬浮窗的整屏画面能从状态栏 / 导航栏后面直接透出来。
             背景图是黑的时这条尤其关键 —— 不透明的话顶上 / 底下各一条黑边，
             白线的顶边和底边就正好被压在下面。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 关键，API 29+ 才有：系统默认会在"透明系统栏"后面再补一层不透明 scrim
             来保证对比度（深色主题下就是纯黑），于是上面那两行 transparent 等于白写。
             必须显式关掉，否则黑底照片 + 黑状态栏就是一团黑。 -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- 系统栏图标 / 文字保持浅色：深色底上只有浅色图标看得清。 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- 内容铺进刘海 / 挖孔区，和悬浮窗的 layoutInDisplayCutoutMode 保持一致。 -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <style name="Theme.NFCTouchDemo" parent="Base.Theme.NFCTouchDemo" />

    <!--pri added by zhuyang,D5: in-app image viewer theme (replaces the Google Photos pager),20261014,start-->
    <!--
      The transition killer. The caller is a Service, so overridePendingTransition is not available
      (it is an Activity method) and FLAG_ACTIVITY_NO_ANIMATION alone is not enough; @null makes
      WindowManager.LayoutParams.windowAnimations 0 for this Activity, which kills the enter and the
      exit animation however the Activity is started. This is the load-bearing part - the
      ActivityOptions.makeCustomAnimation(0, 0) passed by the caller is only belt-and-braces.
    -->
    <style name="Theme.NFCTouchDemo.Viewer" parent="Theme.NFCTouchDemo">
        <item name="android:windowAnimationStyle">@null</item>
        <!-- first frame is already black: no white flash before the bitmap is decoded -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!--pri added by zhuyang,D5: in-app image viewer theme (replaces the Google Photos pager),20261014,end-->
</resources>

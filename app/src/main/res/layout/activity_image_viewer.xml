<?xml version="1.0" encoding="utf-8"?>
<!--
  pri added by zhuyang,D5: in-app image viewer (replaces the Google Photos pager),20261014,start
  Black, nothing but the image: ZoomImageView draws the current photo of this transfer, the counter
  sits above the status bar / cutout, and the failure hint appears only when a decode came back null.
  pri added by zhuyang,D5: in-app image viewer (replaces the Google Photos pager),20261014,end
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.pri.nfctouchdemo.viewer.ZoomImageView
        android:id="@+id/viewer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/viewer_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/viewer_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/viewer_load_failed"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>

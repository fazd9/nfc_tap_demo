<?xml version="1.0" encoding="utf-8"?>
<!--
  pri added by zhuyang,Fail banner (D1): content of a dedicated top-anchored small overlay window,20261014,start
  The window is MATCH_PARENT x WRAP_CONTENT, so everything below this root is real "outside"
  (ACTION_OUTSIDE + NOT_TOUCH_MODAL actually work here, unlike on the full-screen overlay window).
  The dark background must reach y=0 while the text stays below the status bar: the service
  applies topInsetPx() as the root padding.
  pri added by zhuyang,Fail banner (D1): content of a dedicated top-anchored small overlay window,20261014,end
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fail_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#E610151C"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/fail_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fail_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFB9C2CC"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  主页：选一张要发送的照片 → 交给常驻服务，之后两台手机碰一碰即可。

  动效起来之后这个页面会被悬浮窗盖住（铺满整屏），之后的控制（重播 / 停止演示 /
  触摸穿透 / 退出常驻）都在那条常驻通知里。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:fillViewport="true"
    tools:context=".HomeActivity">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="56dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/home_sub"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <!-- 常驻服务 / 演示状态 -->
        <TextView
            android:id="@+id/state_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_state_stopped"
            android:textColor="#FF8A93A0"
            android:textSize="12sp" />

        <!-- 悬浮窗权限没给的时候才出现 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/home_btn_overlay"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 要发送的照片（卡片里那张） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/thumb_photo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/home_slot_photo"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_slot_photo"
                    android:textColor="#FFB8E8FF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_pick_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/home_btn_pick"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!--
          ===== 一碰互联（NFC 那一半） =====
          上面「要发送的照片」那个槽位选的就是碰一碰要传过去的那张：点下面的按钮把它交给
          常驻服务（TapService），之后两台手机碰一碰，发送方直接弹出发送确认页
          （同一套动效页，上滑即发送），接收方弹出接收确认页。
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/home_nfc_title"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nfc_state_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_nfc_idle"
            android:textColor="#FF8A93A0"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_push"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primary"
            android:minHeight="0dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/home_btn_push"
            android:textAllCaps="false"
            android:textColor="#FF111923"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_nfc_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/home_btn_nfc_debug"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/home_nfc_hint"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

        <!-- 服务跑着的时候才出现：关掉悬浮窗之后回到这个页面，就能真的把它停掉 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/home_btn_exit"
            android:textAllCaps="false"
            android:textColor="#FFFFB4B4"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/home_hint"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
